# ---------------------------------------------------------------------------
# GophProfile — пример переменных окружения.
# Скопировать в .env и поправить под себя:  cp .env.example .env
# Файл .env в git не попадает (см. .gitignore).
# ---------------------------------------------------------------------------

# --- Приложение ---
APP_ENV=dev
APP_LOG_LEVEL=debug
APP_HTTP_ADDR=:8080
APP_SHUTDOWN_TIMEOUT=10s
APP_VERSION=0.1.0

# --- Ограничения загрузки ---
APP_MAX_UPLOAD_BYTES=10485760
APP_MAX_IMAGE_PIXELS=50000000
APP_ALLOWED_MIME=image/jpeg,image/png,image/webp

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5433
DB_USER=avatars
DB_PASSWORD=avatars
DB_NAME=avatars
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

# --- S3 / MinIO ---
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
S3_REGION=us-east-1
S3_USE_SSL=false

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=avatars.exchange
RABBITMQ_QUEUE_PROCESS=avatars.process
RABBITMQ_QUEUE_DELETE=avatars.delete
RABBITMQ_QUEUE_RETRY=avatars.retry
RABBITMQ_QUEUE_DEAD=avatars.dead
RABBITMQ_RETRY_TTL=30s
RABBITMQ_MAX_RETRIES=5
RABBITMQ_PREFETCH=4

# --- Worker ---
WORKER_RECONCILE_INTERVAL=1m
WORKER_RECONCILE_AGE=5m

# --- Безопасность ---
# Явный белый список origin. В prod "*" запрещён валидацией конфига.
APP_CORS_ORIGINS=http://localhost:8080
# Общий лимит запросов в минуту с одного адреса. Галерея тянет по запросу
# на миниатюру, поэтому лимит на чтение заметно выше лимита на загрузку.
APP_RATE_LIMIT_RPM=300
APP_RATE_LIMIT_UPLOAD_RPM=10
