{{define "layout"}}<!DOCTYPE html>
<html lang="ru">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{template "title" .}}</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
</head>

<body class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900">
  <div class="container mx-auto px-4 py-8 max-w-3xl">
    <div class="bg-white/10 backdrop-blur-lg rounded-2xl shadow-2xl border border-white/20 overflow-hidden">
      <header class="bg-gradient-to-r from-purple-600 to-blue-600 p-6">
        <h1 class="text-3xl font-bold text-white text-center">{{template "title" .}}</h1>
        <nav class="mt-3 flex justify-center gap-6 text-sm text-white/80">
          <a href="/web/upload" class="underline hover:text-white">Загрузка</a>
          <a href="/web/gallery" class="underline hover:text-white">Галерея</a>
          <a href="/static/" class="underline hover:text-white">Версия на JS</a>
        </nav>
      </header>

      <main class="p-6 space-y-6">{{template "content" .}}</main>
    </div>
  </div>
</body>

</html>{{end}}
